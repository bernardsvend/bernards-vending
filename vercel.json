{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/coolerrewards",
      "destination": "https://rewards.h20crypto.vip/coolerrewards"
    },
    {
      "source": "/coolerrewards/:path*",
      "destination": "https://rewards.h20crypto.vip/coolerrewards/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
